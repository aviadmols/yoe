      <path d="M9.5 36.5l4.2 5.5 5.6-4"/>
      <g stroke-width="2.2"><path d="M33.5 8.8h.01M39 11.6h.01M43.4 16h.01M46.4 21.5h.01M47.6 28h.01M46.6 34.4h.01M43.6 40h.01M39 44.5h.01M33.4 47.3h.01M27.5 48.2h.01M21.8 47.2h.01"/></g>
      <path d="M28 16v13l-7 5"/>
    {%- when 'delivery' -%}
      <path d="M13 7v13M8.5 15.5 13 20l4.5-4.5M43 7v13M38.5 15.5 43 20l4.5-4.5"/>
