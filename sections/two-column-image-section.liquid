{% schema %}
{
  "name": "Two Column Images",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "pdp", "label": "Product page (spaced)" }
      ],
      "default": "default"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image"
    }
  ],
  "presets": [
    {
      "name": "Two Column Images",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="two-column-images{% if section.settings.layout_style == 'pdp' %} two-column-images--pdp{% endif %}{% render 'pdp-scroll-animate-class' %}">
    <div class="page-width">
  <div class="container-section-image">
    {% if section.settings.left_image != blank %}
      <div class="image-col">
        <img src="{{ section.settings.left_image | image_url: width: 1200 }}" srcset="{{ section.settings.left_image | image_url: width: 600 }} 600w, {{ section.settings.left_image | image_url: width: 900 }} 900w, {{ section.settings.left_image | image_url: width: 1200 }} 1200w, {{ section.settings.left_image | image_url: width: 1600 }} 1600w" sizes="(min-width: 750px) 50vw, 100vw" loading="lazy" alt="Left Image">
      </div>
    {% endif %}

    {% if section.settings.right_image != blank %}
      <div class="image-col">
        <img src="{{ section.settings.right_image | image_url: width: 1200 }}" srcset="{{ section.settings.right_image | image_url: width: 600 }} 600w, {{ section.settings.right_image | image_url: width: 900 }} 900w, {{ section.settings.right_image | image_url: width: 1200 }} 1200w, {{ section.settings.right_image | image_url: width: 1600 }} 1600w" sizes="(min-width: 750px) 50vw, 100vw" loading="lazy" alt="Right Image">
      </div>
    {% endif %}
  </div>
  </div>
</section>

<style>

.two-column-images .container-section-image {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 24px;
}
section.two-column-images {
    background: #fff;
    position: relative;
    z-index: 11;
}
.two-column-images .image-col {
  flex: 1;
}
section.two-column-images .page-width {
    padding: 0px 20px;
}
.two-column-images img {
    width: 100%;
    display: block;
    object-fit: cover;
    height: 100%;
}
/* Mobile Responsive */
@media (max-width: 767px) {
{% comment %} section.two-column-images .page-width {
    padding: 0px 14px;
} {% endcomment %}
  .two-column-images .container {
    flex-direction: column;
    gap: 20px;
  }
.two-column-images .container-section-image {
    flex-direction: column;
    gap: 14px;
}
}

/* Product page style (PDP Figma: desktop 20px = 1rem, mobile 375px) */
@media (min-width: 768px) {
  section.two-column-images--pdp .page-width {
    max-width: none;
    padding: 2.8rem 1.6rem 0 2.9rem;
  }

  .two-column-images--pdp .container-section-image {
    gap: 2.15rem;
  }

  .two-column-images--pdp .image-col:first-child {
    flex: 916;
  }

  .two-column-images--pdp .image-col:last-child {
    flex: 871;
  }

  .two-column-images--pdp img {
    height: 37.35rem;
  }
}

@media (max-width: 767px) {
  section.two-column-images--pdp {
    background: #f7f6f5;
  }

  section.two-column-images--pdp .page-width {
    padding: 40px 13px 0;
  }

  .two-column-images--pdp img {
    height: 339px;
  }
}
</style>
