{{ 'discovery-duo-bf.css' | asset_url | stylesheet_tag }}

<section class="dd-bf-hero" aria-label="{{ section.settings.top_headline | default: section.settings.headline | escape }}">
  {%- if section.settings.top_headline != blank -%}
    <div class="dd-bf-hero__top">
      <h1 class="dd-bf-hero__top-headline">{{ section.settings.top_headline | escape }}</h1>
    </div>
  {%- endif -%}

  <div class="dd-bf-hero__split">
    <div class="dd-bf-hero__media">
      {% render 'dd-bf-image',
        image: section.settings.image,
        asset: section.settings.image_asset,
        mobile_image: section.settings.mobile_image,
        mobile_asset: section.settings.mobile_image_asset,
        width: 1400,
        mobile_width: 800,
        sizes: '(max-width: 749px) 100vw, 50vw',
        loading: 'eager',
        fetchpriority: 'high',
        class: 'dd-bf-hero__image',
        alt: section.settings.image_alt
      %}
      {%- if section.settings.image_title != blank -%}
        <p class="dd-bf-hero__image-title">{{ section.settings.image_title | escape }}</p>
      {%- endif -%}
    </div>

    <div class="dd-bf-hero__content">
      {%- if section.settings.badge_text != blank -%}
        <span class="dd-bf-hero__badge">{{ section.settings.badge_text | escape }}</span>
      {%- endif -%}

      {%- if section.settings.headline != blank -%}
        <h2 class="dd-bf-hero__headline">{{ section.settings.headline | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheadline != blank -%}
        <p class="dd-bf-hero__subheadline">{{ section.settings.subheadline | escape }}</p>
      {%- endif -%}

      {% render 'dd-bf-cta', s: section.settings, align: 'left', modifier: 'dd-bf-cta--hero' %}

      {%- if section.settings.orders_text != blank -%}
        <p class="dd-bf-hero__orders">{{ section.settings.orders_text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.press_quote != blank -%}
        <figure class="dd-bf-hero__press">
          <blockquote class="dd-bf-hero__press-quote">“{{ section.settings.press_quote | escape }}”</blockquote>
          {%- if section.settings.press_source != blank -%}
            <figcaption class="dd-bf-hero__press-source">{{ section.settings.press_source | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}

      {%- if section.settings.social_proof != blank -%}
        <p class="dd-bf-hero__social">{{ section.settings.social_proof | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- capture press_items -%}
      {%- for block in section.blocks -%}
        <span class="dd-bf-press__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
        <span class="dd-bf-press__sep" aria-hidden="true">·</span>
      {%- endfor -%}
    {%- endcapture -%}
    <div class="dd-bf-press{% if section.settings.press_scroll %} dd-bf-press--scroll{% endif %}" style="--dd-bf-press-speed: {{ section.settings.press_speed }}s;">
      <p class="visually-hidden">{{ section.settings.press_label | escape }}: {% for block in section.blocks %}{{ block.settings.text | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
      <div class="dd-bf-press__track" aria-hidden="true">
        <div class="dd-bf-press__group">{{ press_items }}{{ press_items }}</div>
        {%- if section.settings.press_scroll -%}
          <div class="dd-bf-press__group">{{ press_items }}{{ press_items }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var hero = document.currentScript && document.currentScript.previousElementSibling;
    if (!hero || !hero.classList.contains('dd-bf-hero')) return;
    function sync() {
      var header = document.querySelector('.header_sections');
      if (!header || getComputedStyle(header).position !== 'fixed') {
        hero.style.removeProperty('--dd-bf-header-h');
        return;
      }
      if (window.scrollY > 10 && hero.style.getPropertyValue('--dd-bf-header-h')) return;
      hero.style.setProperty('--dd-bf-header-h', Math.round(header.getBoundingClientRect().height) + 'px');
    }
    sync();
    window.addEventListener('load', sync, { once: true });
    window.addEventListener('resize', sync, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "BF – Hero",
  "tag": "div",
  "class": "section-dd-bf-hero",
  "settings": [
    { "type": "text", "id": "top_headline", "label": "Headline above the hero", "default": "Our biggest sale of the year." },
    { "type": "header", "content": "Image (right on desktop, top on mobile)" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "text", "id": "image_asset", "label": "Desktop image fallback (theme asset)", "default": "bf-hero-desktop.webp", "info": "Used only while no image is picked above." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "mobile_image_asset", "label": "Mobile image fallback (theme asset)", "default": "bf-hero-mobile.webp" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Yoé creams and refills on black gift boxes with a red ribbon" },
    { "type": "text", "id": "image_title", "label": "Title on the image", "default": "Black Friday Sale" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "badge_text", "label": "Badge", "default": "Clinically proven" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Visibly firms, plumps, and reduces fine lines and wrinkles" },
    { "type": "text", "id": "subheadline", "label": "Subheadline (red)", "default": "All in one formula." },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_sale_text", "label": "Sale line above the button", "default": "Black Friday Sale · Save 20%" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get award-winning cream" },
    { "type": "text", "id": "cta_compare_price", "label": "Compare-at price (struck through)", "default": "$185", "info": "Leave empty to use the product compare-at price." },
    { "type": "text", "id": "cta_price", "label": "Sale price", "default": "$148", "info": "Leave empty to use the product price." },
    { "type": "product", "id": "cta_product", "label": "Product" },
    { "type": "product", "id": "cta_product_secondary", "label": "Bonus product (optional)" },
    { "type": "checkbox", "id": "cta_go_to_checkout", "label": "Go directly to checkout", "default": true },
    { "type": "checkbox", "id": "cta_apply_discount", "label": "Apply discount code on checkout", "default": true },
    { "type": "text", "id": "cta_checkout_discount_code", "label": "Discount code" },
    { "type": "text", "id": "trust_1", "label": "Trust item 1", "default": "30-Day Money-Back" },
    { "type": "text", "id": "trust_2", "label": "Trust item 2", "default": "Free Express Shipping" },
    { "type": "text", "id": "trust_3", "label": "Trust item 3", "default": "Limited-Time Offer" },
    { "type": "header", "content": "Social proof" },
    { "type": "text", "id": "orders_text", "label": "Orders line", "default": "1,000+ orders" },
    { "type": "text", "id": "press_quote", "label": "Press quote", "default": "Acts as a gentle retinol alternative" },
    { "type": "text", "id": "press_source", "label": "Press source", "default": "The Sunday Times" },
    { "type": "text", "id": "social_proof", "label": "Line under the quote", "default": "loved by 100+ celebrity makeup artists & estheticians" },
    { "type": "header", "content": "Press strip" },
    { "type": "text", "id": "press_label", "label": "Accessible label", "default": "As featured in" },
    { "type": "checkbox", "id": "press_scroll", "label": "Scroll the press names", "default": true },
    { "type": "range", "id": "press_speed", "label": "Scroll duration", "min": 10, "max": 80, "step": 2, "unit": "s", "default": 36 }
  ],
  "blocks": [
    {
      "type": "press",
      "name": "Press name",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "text", "label": "Name", "default": "Glamour" }
      ]
    }
  ],
  "presets": [{ "name": "BF – Hero" }]
}
{% endschema %}
