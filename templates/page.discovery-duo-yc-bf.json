        "question_bf1": {
          "type": "question",
          "settings": {
            "question": "What are the benefits of Ympossible Cream?",
            "answer": "<ul><li>Deeply hydrates and nourishes the skin.</li><li>Helps smooth the appearance of fine lines and wrinkles.</li><li>Helps improve firmness and elasticity.</li><li>Helps reduce the appearance of dark spots and uneven tone.</li><li>Supports the skin’s moisture barrier.</li><li>Helps soothe the appearance of redness.</li></ul>"
          }
        },
        "question_bf2": {
          "type": "question",
          "settings": {
            "question": "What is the difference between Ympossible Cream and Ympossible Cream Light?",
            "answer": "<ul><li>Ympossible Cream: A rich, restorative cream with a velvety texture and satin finish, suited to normal-to-dry skin and dry climates.</li><li>Ympossible Cream Light: A lightweight cream with an airy texture and dewy finish, suited to normal-to-oily skin and hot, humid climates.</li></ul>"
          }
        },
        "question_bf3": {
          "type": "question",
          "settings": {
            "question": "Which skin types is Ympossible Cream best suited to?",
            "answer": "<p>Ympossible Cream is especially suited to normal-to-dry skin and dry climates. Its rich, velvety texture leaves a soft satin finish. It is also suitable for sensitive skin.</p>"
          }
        },
        "question_bf4": {
          "type": "question",
          "settings": {
            "question": "How do I use Ympossible Cream?",
            "answer": "<p>Apply to cleansed, dry skin on the face, neck and décolletage, morning and evening, or as a smooth base before makeup. For more intensive nourishment, apply a generous layer as an overnight treatment.</p>"
          }
        },
        "question_bf5": {
          "type": "question",
          "settings": {
            "question": "Is Ympossible Cream suitable for sensitive skin?",
            "answer": "<p>Yes. Ympossible Cream is suitable for sensitive skin and is fragrance-free.</p>"
          }
        },
        "question_bf6": {
          "type": "question",
          "settings": {
            "question": "What formulation standards does Ympossible Cream meet?",
            "answer": "<p>Ympossible Cream is a clinically tested, fragrance-free formula. It is EWG Verified, Leaping Bunny certified and vegan.</p>"
          }
        },
        "question_bf7": {
          "type": "question",
          "settings": {
            "question": "Is Ympossible Cream vegan and cruelty-free?",
            "answer": "<p>Yes. Ympossible Cream is vegan and cruelty-free, and is Leaping Bunny certified.</p>"
          }
        }
      },
