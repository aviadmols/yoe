{{ 'discovery-duo-bf.css' | asset_url | stylesheet_tag }}

<section
  class="dd-bf-section dd-bf-faq"
  style="--dd-bf-bg: {{ section.settings.background }}; --dd-bf-pt: {{ section.settings.padding_top }}; --dd-bf-pb: {{ section.settings.padding_bottom }};"
>
  <div class="dd-bf-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="dd-bf-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="dd-bf-faq__list">
        {%- for block in section.blocks -%}
          <details class="dd-bf-faq__item" {% if section.settings.open_all %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="dd-bf-faq__question">
              <span>{{ block.settings.question | escape }}</span>
              <span class="dd-bf-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="dd-bf-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BF – FAQ",
  "tag": "div",
  "class": "section-dd-bf-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "checkbox", "id": "open_all", "label": "Show answers open on load", "default": true },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7f6f5" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop rem ×10)", "min": 0, "max": 100, "step": 2, "default": 42 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop rem ×10)", "min": 0, "max": 100, "step": 2, "default": 34 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I use it?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer text.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "BF – FAQ" }]
}
{% endschema %}
