{%- liquid
  assign pdp_scroll_animate = false
  if keep and template.name == 'product'
    if template.suffix == 'ympossible-cream-light-ycl' or template.suffix == 'ympossible-cream-yc' or template.suffix == 'ympossible-serum'
      assign pdp_scroll_animate = true
    endif
  endif
-%}{% if pdp_scroll_animate %} scroll-trigger animate--slide-in{% endif %}
