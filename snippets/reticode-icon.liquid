      <path d="M38 14 12 50"/>
      <path d="M25.5 25.5 20 24.7M30.6 18.6 26.4 18M21 31.7l-6.4-.8M33.5 22.5 39 23.5M28.6 29.3l6.8 1.3"/>
  {%- endcase -%}
