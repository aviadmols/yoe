{%- comment -%}
  PDP benefit icons row (default: Firms / Hydrates / Smooths / Brightens).
  Accepts: icons (optional) - comma-separated list of firms, hydrates, smooths, brightens, renews, blurs
  Self-contained styling so no shared CSS is touched.
{%- endcomment -%}
{%- assign benefit_icons = icons | default: 'firms,hydrates,smooths,brightens' | split: ',' -%}
<ul class="pdp-benefit-icons" role="list">
  {%- for benefit in benefit_icons -%}
    {%- assign benefit_key = benefit | strip | downcase -%}
    {%- assign benefit_label = benefit_key | capitalize -%}
    <li class="pdp-benefit-icons__item">
      <img class="pdp-benefit-icons__icon" src="{{ 'pdp-benefit-' | append: benefit_key | append: '.svg' | asset_url }}" alt="{{ benefit_label }}" loading="lazy" width="28" height="22">
      <span class="pdp-benefit-icons__label">{{ benefit_label }}</span>
    </li>
  {%- endfor -%}
</ul>

<style>
  /* Sizes authored in rem at the 20px = 1rem design ratio (1920px design width). */
  .pdp-benefit-icons {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    gap: 0.6rem;
    margin: 0.6rem 0;
    padding: 0;
    list-style: none;
  }

  .pdp-benefit-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  .pdp-benefit-icons__icon {
    display: block;
    width: 2rem;
    height: auto;
    object-fit: contain;
  }

  .pdp-benefit-icons__label {
    color: #666460;
    font-family: "Open Sans", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
    font-variation-settings: "wdth" 86;
  }

  /* Mobile: match the Figma mobile layout (icons spread full width). */
  @media screen and (max-width: 749px) {
    .pdp-benefit-icons {
      margin: 18px 0 20px;
    }

    .pdp-benefit-icons__icon {
      width: 2.4rem;
      height: 25px;
      object-fit: contain;
    }

    .pdp-benefit-icons__label {
      color: #666460;
      text-align: center;
      font-family: "Open Sans";
      font-size: 8.483px;
      font-style: normal;
      font-weight: 700;
      line-height: 140%; /* 11.877px */
      letter-spacing: 0.848px;
      text-transform: uppercase;
    }
  }
</style>
