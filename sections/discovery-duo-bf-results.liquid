{{ 'discovery-duo-bf.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign review_blocks = section.blocks | where: 'type', 'review'
-%}

<section
  class="dd-bf-results dd-bf-section"
  style="--dd-bf-pt: {{ section.settings.padding_top }}; --dd-bf-pb: {{ section.settings.padding_bottom }}; --dd-bf-bg: {{ section.settings.background }};"
>
  <div class="dd-bf-container">
    {%- if section.settings.headline != blank -%}
      <h2 class="dd-bf-heading">{{ section.settings.headline | escape }}</h2>
    {%- endif -%}

    <div class="dd-bf-results__grid">
      <div class="dd-bf-results__intro">
        {%- if section.settings.product_name != blank -%}
          <h3 class="dd-bf-results__product">{{ section.settings.product_name | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.awards != blank -%}
          <p class="dd-bf-results__awards">{{ section.settings.awards | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>

      <div class="dd-bf-results__media">
        {% render 'dd-bf-image',
          image: section.settings.image,
          asset: section.settings.image_asset,
          mobile_image: section.settings.mobile_image,
          mobile_asset: section.settings.mobile_image_asset,
          width: 1400,
          mobile_width: 800,
          sizes: '(max-width: 749px) 100vw, 40vw',
          class: 'dd-bf-results__image',
          alt: section.settings.image_alt
        %}
        {%- if section.settings.disclaimer != blank -%}
          <p class="dd-bf-results__disclaimer dd-bf-results__disclaimer--desktop">{{ section.settings.disclaimer | escape }}</p>
        {%- endif -%}
      </div>

      {%- if stat_blocks.size > 0 -%}
        <ul class="dd-bf-results__stats" role="list">
          {%- for block in stat_blocks -%}
            <li class="dd-bf-results__stat" {{ block.shopify_attributes }}>
              <p class="dd-bf-results__stat-top">{{ block.settings.top | escape }}</p>
              <p class="dd-bf-results__stat-value">{{ block.settings.value | escape }}</p>
              <p class="dd-bf-results__stat-bottom">{{ block.settings.bottom | escape }}</p>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="dd-bf-results__disclaimer dd-bf-results__disclaimer--mobile">{{ section.settings.disclaimer | escape }}</p>
      {%- endif -%}
    </div>

    {%- if review_blocks.size > 0 -%}
      <div class="dd-bf-results__reviews">
        {%- if section.settings.reviews_headline != blank -%}
          <h3 class="dd-bf-heading dd-bf-heading--sub">{{ section.settings.reviews_headline | escape }}</h3>
        {%- endif -%}
        <ul class="dd-bf-results__review-list" role="list">
          {%- for block in review_blocks -%}
            <li class="dd-bf-review dd-bf-review--large" {{ block.shopify_attributes }}>
              <p class="dd-bf-review__stars" aria-label="5 out of 5 stars">★★★★★</p>
              {%- if block.settings.title != blank -%}<p class="dd-bf-review__title">{{ block.settings.title | escape }}</p>{%- endif -%}
              {%- if block.settings.quote != blank -%}<p class="dd-bf-review__quote">“{{ block.settings.quote | escape }}”</p>{%- endif -%}
              {%- if block.settings.author != blank -%}<p class="dd-bf-review__author">{{ block.settings.author | escape }}</p>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {% render 'dd-bf-cta', s: section.settings %}
  </div>
</section>

{% schema %}
{
  "name": "BF – Results",
  "tag": "div",
  "class": "section-dd-bf-results",
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "Visibly transformed." },
    { "type": "text", "id": "product_name", "label": "Product name", "default": "Ympossible Cream" },
    { "type": "textarea", "id": "awards", "label": "Awards (one per line)", "default": "Best Night Cream · Oprah Daily\nBest Ultra-Rich Face Moisturizer · Cosmopolitan" },
    { "type": "header", "content": "Before / after image" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "text", "id": "image_asset", "label": "Desktop image fallback (theme asset)", "default": "bf-yc-before-after-desktop.webp" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "mobile_image_asset", "label": "Mobile image fallback (theme asset)", "default": "bf-yc-before-after-mobile.webp" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Before and after 4 weeks of Ympossible Cream" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "*In an instrumental clinical trial of 22 subjects after 4 and 8 weeks of twice-daily use. Individual results may vary." },
    { "type": "text", "id": "reviews_headline", "label": "Reviews headline", "default": "In their own words." },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_sale_text", "label": "Sale line above the button", "default": "Black Friday Sale · Save 20%" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get award-winning cream" },
    { "type": "text", "id": "cta_compare_price", "label": "Compare-at price (struck through)", "default": "$185" },
    { "type": "text", "id": "cta_price", "label": "Sale price", "default": "$148" },
    { "type": "product", "id": "cta_product", "label": "Product" },
    { "type": "product", "id": "cta_product_secondary", "label": "Bonus product (optional)" },
    { "type": "checkbox", "id": "cta_go_to_checkout", "label": "Go directly to checkout", "default": true },
    { "type": "checkbox", "id": "cta_apply_discount", "label": "Apply discount code on checkout", "default": true },
    { "type": "text", "id": "cta_checkout_discount_code", "label": "Discount code" },
    { "type": "text", "id": "trust_1", "label": "Trust item 1", "default": "30-Day Money-Back" },
    { "type": "text", "id": "trust_2", "label": "Trust item 2", "default": "Free Express Shipping" },
    { "type": "text", "id": "trust_3", "label": "Trust item 3", "default": "Limited-Time Offer" },
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop rem ×10)", "min": 0, "max": 100, "step": 2, "default": 50 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop rem ×10)", "min": 0, "max": 100, "step": 2, "default": 50 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "top", "label": "Label", "default": "Forehead wrinkle depth reduced by up to" },
        { "type": "text", "id": "value", "label": "Value", "default": "66.7%" },
        { "type": "text", "id": "bottom", "label": "Timeframe", "default": "in only 4 weeks" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Best product I have ever used" },
        { "type": "textarea", "id": "quote", "label": "Quote (without quote marks)", "default": "my skin felt softer, smoother, and genuinely nourished." },
        { "type": "text", "id": "author", "label": "Author", "default": "Yannick L." }
      ]
    }
  ],
  "presets": [{ "name": "BF – Results" }]
}
{% endschema %}
