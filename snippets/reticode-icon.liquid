{%- comment -%}
  Line icons for the RetiCode comparison rows. Stroke uses currentColor.
  Accepts: icon (irritation | daytime | barrier | adjustment | delivery | sensitive)
{%- endcomment -%}
<svg class="rc__icon rc__icon--{{ icon }}" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'irritation' -%}
      <path d="M28 8v9M18.5 10.5l3.5 7M37.5 10.5l-3.5 7"/>
      <path d="M6 27c3.7-3.4 7.3-3.4 11 0s7.3 3.4 11 0 7.3-3.4 11 0 7.3 3.4 11 0"/>
